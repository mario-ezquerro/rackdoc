# Configuración de Puertos Docker
BACKEND_PORT=8180
FRONTEND_PORT=8181

# Credenciales del Administrador Inicial.
# La contraseña se guarda hasheada con bcrypt; este valor solo se usa para
# crearla (o re-sincronizarla) en el arranque. Cámbiala antes de exponer el servicio.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@rackdoc.local

# Base de datos
DATABASE_URL=sqlite:////app/data/rackdoc.db

# Seguridad: secreto de firma de los JWT de sesión.
# OBLIGATORIO en producción. Si se deja vacío, el backend genera uno aleatorio
# por proceso: funciona en local, pero las sesiones caducan en cada reinicio y
# no se comparten entre réplicas. Genera uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Validez de la sesión en minutos (por defecto 480 = 8 h)
JWT_TTL_MINUTES=480

# Orígenes autorizados para CORS, separados por comas.
CORS_ALLOW_ORIGINS=http://localhost:8181,http://127.0.0.1:8181

# Clave para la API máquina-a-máquina (/api/v1/automation/* y /api/v1/metrics,
# que es la que consume Prometheus). Si se deja vacía, esos endpoints devuelven
# 503 y quedan deshabilitados. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOMATION_API_KEY=

PING_INTERVAL_SECONDS=60
